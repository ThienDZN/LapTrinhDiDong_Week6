<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình TÀI KHOẢN (giống trang "Tôi" của Shopee): ảnh nền + avatar + tên, mục Đơn mua theo trạng thái,
     các lối tắt (đã thích, giỏ hàng, hồ sơ, cài đặt) và đăng xuất -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Phần đầu: ảnh nền thành phố về đêm + avatar + tên + vai trò -->
        <FrameLayout
            android:id="@+id/headerBox"
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_city" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_fade" />

            <!-- Nút quay lại (trắng, nổi trên ảnh) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:id="@+id/headerProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvAvatar"
                    style="@style/Widget.App.Avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:textSize="26sp"
                    tools:text="Q" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        tools:text="Quản trị viên" />

                    <TextView
                        android:id="@+id/tvRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_price_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/price"
                        tools:text="Quản trị viên" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_profile_link"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </FrameLayout>

        <!-- Đơn mua: 4 trạng thái kèm số lượng, bấm để xem đơn theo trạng thái -->
        <com.google.android.material.card.MaterialCardView
            style="@style/FormCard"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:contentPadding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowAllOrders"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/my_orders"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_all_orders"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/box0" style="@style/OrderStatusBox">
                        <!-- Icon trong vòng tròn + huy hiệu số đơn ở góc trên phải -->
                        <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_status_icon"
                                android:contentDescription="@null"
                                android:padding="11dp"
                                android:src="@drawable/ic_status_prep"
                                app:tint="?attr/colorPrimary" />
                            <TextView
                                android:id="@+id/tvCount0"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_badge"
                                android:gravity="center"
                                android:minWidth="22dp"
                                android:minHeight="22dp"
                                android:paddingHorizontal="4dp"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="2"
                                tools:visibility="visible" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="@string/step_short_0"
                            android:textAppearance="@style/TextAppearance.App.Label" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/box1" style="@style/OrderStatusBox">
                        <!-- Icon trong vòng tròn + huy hiệu số đơn ở góc trên phải -->
                        <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_status_icon"
                                android:contentDescription="@null"
                                android:padding="11dp"
                                android:src="@drawable/ic_status_ship"
                                app:tint="?attr/colorPrimary" />
                            <TextView
                                android:id="@+id/tvCount1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_badge"
                                android:gravity="center"
                                android:minWidth="22dp"
                                android:minHeight="22dp"
                                android:paddingHorizontal="4dp"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="2"
                                tools:visibility="visible" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="@string/step_short_1"
                            android:textAppearance="@style/TextAppearance.App.Label" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/box2" style="@style/OrderStatusBox">
                        <!-- Icon trong vòng tròn + huy hiệu số đơn ở góc trên phải -->
                        <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_status_icon"
                                android:contentDescription="@null"
                                android:padding="11dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="?attr/colorPrimary" />
                            <TextView
                                android:id="@+id/tvCount2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_badge"
                                android:gravity="center"
                                android:minWidth="22dp"
                                android:minHeight="22dp"
                                android:paddingHorizontal="4dp"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="2"
                                tools:visibility="visible" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="@string/step_short_2"
                            android:textAppearance="@style/TextAppearance.App.Label" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/box3" style="@style/OrderStatusBox">
                        <!-- Icon trong vòng tròn + huy hiệu số đơn ở góc trên phải -->
                        <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_status_icon"
                                android:contentDescription="@null"
                                android:padding="11dp"
                                android:src="@drawable/ic_status_cancel"
                                app:tint="?attr/colorPrimary" />
                            <TextView
                                android:id="@+id/tvCount3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_badge"
                                android:gravity="center"
                                android:minWidth="22dp"
                                android:minHeight="22dp"
                                android:paddingHorizontal="4dp"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="2"
                                tools:visibility="visible" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="@string/step_short_3"
                            android:textAppearance="@style/TextAppearance.App.Label" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/box4" style="@style/OrderStatusBox">
                        <!-- Icon trong vòng tròn + huy hiệu số đơn ở góc trên phải -->
                        <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_status_icon"
                                android:contentDescription="@null"
                                android:padding="11dp"
                                android:src="@drawable/ic_status_return"
                                app:tint="?attr/colorPrimary" />
                            <TextView
                                android:id="@+id/tvCount4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_badge"
                                android:gravity="center"
                                android:minWidth="22dp"
                                android:minHeight="22dp"
                                android:paddingHorizontal="4dp"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="2"
                                tools:visibility="visible" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="@string/step_short_4"
                            android:textAppearance="@style/TextAppearance.App.Label" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Lối tắt -->
        <com.google.android.material.card.MaterialCardView
            style="@style/FormCard"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:contentPadding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/rowFavorites" style="@style/MenuRow"
                    android:text="@string/nav_favorites" app:drawableStartCompat="@drawable/ic_favorite" />
                <TextView android:id="@+id/rowCart" style="@style/MenuRow"
                    android:text="@string/cart_title" app:drawableStartCompat="@drawable/ic_cart" />
                <TextView android:id="@+id/rowProfile" style="@style/MenuRow"
                    android:text="@string/nav_profile" app:drawableStartCompat="@drawable/ic_person" />
                <TextView android:id="@+id/rowSettings" style="@style/MenuRow"
                    android:text="@string/settings_title" app:drawableStartCompat="@drawable/ic_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnLogout"
            style="@style/Widget.App.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:text="@string/btn_logout"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
