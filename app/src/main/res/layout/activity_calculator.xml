<?xml version="1.0" encoding="utf-8"?>
<!-- Tuần 1 - Bài 6: máy tính (chuyển từ Bai6_Calculator) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="12dp"
    android:fitsSystemWindows="true"
    tools:context=".CalculatorActivity">

    <!-- Top app bar: quay lại + tiêu đề -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/title_calculator" />

    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="24sp"
        tools:text="12 +" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="12dp"
        android:autoSizeMaxTextSize="64sp"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeTextType="uniform"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:text="0"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout style="@style/CalcRow">
        <Button
            android:id="@+id/btnClear"
            style="@style/CalcButton.Func"
            android:text="C" />
        <Button
            android:id="@+id/btnSign"
            style="@style/CalcButton.Func"
            android:text="±" />
        <Button
            android:id="@+id/btnPercent"
            style="@style/CalcButton.Func"
            android:text="%" />
        <Button
            android:id="@+id/btnDiv"
            style="@style/CalcButton.Op"
            android:text="÷" />
    </LinearLayout>

    <LinearLayout style="@style/CalcRow">
        <Button
            android:id="@+id/btn7"
            style="@style/CalcButton"
            android:text="7" />
        <Button
            android:id="@+id/btn8"
            style="@style/CalcButton"
            android:text="8" />
        <Button
            android:id="@+id/btn9"
            style="@style/CalcButton"
            android:text="9" />
        <Button
            android:id="@+id/btnMul"
            style="@style/CalcButton.Op"
            android:text="×" />
    </LinearLayout>

    <LinearLayout style="@style/CalcRow">
        <Button
            android:id="@+id/btn4"
            style="@style/CalcButton"
            android:text="4" />
        <Button
            android:id="@+id/btn5"
            style="@style/CalcButton"
            android:text="5" />
        <Button
            android:id="@+id/btn6"
            style="@style/CalcButton"
            android:text="6" />
        <Button
            android:id="@+id/btnSub"
            style="@style/CalcButton.Op"
            android:text="-" />
    </LinearLayout>

    <LinearLayout style="@style/CalcRow">
        <Button
            android:id="@+id/btn1"
            style="@style/CalcButton"
            android:text="1" />
        <Button
            android:id="@+id/btn2"
            style="@style/CalcButton"
            android:text="2" />
        <Button
            android:id="@+id/btn3"
            style="@style/CalcButton"
            android:text="3" />
        <Button
            android:id="@+id/btnAdd"
            style="@style/CalcButton.Op"
            android:text="+" />
    </LinearLayout>

    <LinearLayout style="@style/CalcRow">
        <Button
            android:id="@+id/btn0"
            style="@style/CalcButton"
            android:text="0" />
        <Button
            android:id="@+id/btnDot"
            style="@style/CalcButton"
            android:text="." />
        <Button
            android:id="@+id/btnBackspace"
            style="@style/CalcButton"
            android:text="⌫" />
        <Button
            android:id="@+id/btnEquals"
            style="@style/CalcButton.Op"
            android:text="=" />
    </LinearLayout>

</LinearLayout>
