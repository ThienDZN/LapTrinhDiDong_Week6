<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Theme chung: Material 3 nền tối kiểu sân khấu âm nhạc ===== -->
    <style name="Theme.Thien" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Color scheme (giá trị nằm ở values/colors.xml) -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="colorOnBackground">@color/md_on_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceDim">@color/md_surface_dim</item>
        <item name="colorSurfaceBright">@color/md_surface_bright</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>

        <!-- Status bar / navigation bar hòa vào nền -->
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <!-- Component mặc định -->
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="textInputStyle">@style/Widget.App.TextField</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog</item>
    </style>

    <!-- Top app bar: nền surface, icon theo màu onSurface -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
    </style>

    <!-- Ô nhập: outlined, bo góc 12dp -->
    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Ô tìm kiếm: filled, bo tròn hoàn toàn, không gạch chân -->
    <style name="Widget.App.SearchField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>


    <style name="ShapeAppearance.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Chip nhỏ chỉ để hiển thị (trang Profile) -->
    <style name="DetailChip" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="chipIconTint">?attr/colorPrimary</item>
        <item name="chipIconVisible">true</item>
    </style>

    <!-- Thanh dưới cùng (Detail, Cart): bo 2 góc trên -->
    <style name="ShapeAppearance.App.BottomBar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===== Nút bấm theo chuẩn Material 3 =====
         - bo tròn hoàn toàn (ShapeAppearance Corner.Full), phẳng, hiệu ứng nhấn (state layer) có sẵn của M3
         - nút lớn cao 56dp, chữ Title Medium (16sp); nút nhỏ giữ cỡ chuẩn M3 (cao 40dp, chữ Label Large) -->

    <!-- Nút chính (Filled): nền cam, chữ tối. Dùng cho hành động quan trọng nhất: ĐẶT MÓN, THÊM VÀO GIỎ... -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button.Icon">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="iconPadding">12dp</item>
    </style>

    <!-- Nút phụ (Outlined): viền cam, nền trong. Dùng cho hành động thứ hai: Trả hàng, Viết nhận xét... -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="iconPadding">12dp</item>
    </style>

    <!-- Nút nhỏ (Tonal): nền cam sẫm, chữ cam sáng. Dùng cho Thích, Bình luận, Chia sẻ, Đánh giá món -->
    <style name="Widget.App.Button.Tonal" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- Nút nguy hiểm (Outlined màu lỗi): Đăng xuất, Hủy đơn, Hủy mã -->
    <style name="Widget.App.Button.Danger" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorError</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="iconTint">?attr/colorError</item>
        <item name="iconPadding">12dp</item>
        <item name="strokeColor">?attr/colorError</item>
        <item name="rippleColor">?attr/colorError</item>
    </style>

    <style name="ThemeOverlay.App.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <!-- Nút lớn (full width) trên form -->
    <style name="Widget.App.Button.Large" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <!-- Avatar chữ cái đầu: hình tròn primaryContainer -->
    <style name="Widget.App.Avatar" parent="">
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Nhãn nhỏ + giá trị trong danh sách thông tin -->
    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.Value" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Dòng thông tin ở trang Profile (kiểu Material list item 2 dòng) -->
    <style name="ProfileRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

    <style name="ProfileRowIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">?attr/colorPrimary</item>
    </style>

    <style name="ProfileRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ProfileRowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
    </style>

    <style name="ProfileRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Value</item>
    </style>


    <!-- Tiêu đề mục ở trang chi tiết / đơn hàng -->
    <style name="DetailSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Thẻ nhóm thông tin (Album, Thanh toán, Đơn hàng) -->
    <style name="FormCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="contentPadding">16dp</item>
    </style>



    <!-- 1 dòng bấm được ở trang Tài khoản / Cài đặt: icon trái, chữ, mũi tên phải -->
    <style name="MenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="drawableTint">?attr/colorPrimary</item>
        <item name="drawableEndCompat">@drawable/ic_chevron_right</item>
    </style>

    <!-- 1 ô trạng thái đơn ở trang Tài khoản (icon + huy hiệu số đơn + chữ) -->
    <style name="OrderStatusBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Tuần 1 - Bài 6: style cho máy tính (chuyển từ Bai6_Calculator/themes.xml) -->
    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1.2</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CalcButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="CalcButton.Op">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="CalcButton.Func">
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
    </style>
</resources>
